# Copy to .env (never commit it). The app loads it automatically.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
# LLM: provider is "groq" or "anthropic"
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# Jira (optional for commit reviews; used when a ticket ID like KAN-12 is in the branch/commit message)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_AC_FIELD=
REQUIRE_TICKET=false
MAX_DIFF_CHARS=60000
DRY_RUN=true
